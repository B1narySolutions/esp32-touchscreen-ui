    <!-- Fonts exported from the same families used in the HTML prototype -->
    <fonts>
        <bin name="font_body_14" file="fonts/manrope_14.bin"/>
        <bin name="font_body_bold_15" file="fonts/manrope_bold_15.bin"/>
        <bin name="font_mono_12" file="fonts/plex_mono_12.bin"/>
        <bin name="font_value_18" file="fonts/plex_mono_18.bin"/>
    </fonts>

    <!-- Shared subjects (observable state) the exported C wires up to real audio params -->
    <subjects>
        <int name="subj_master_volume" value="63"/>
        <int name="subj_backlight" value="80"/>
        <int name="subj_selected_effect" value="3"/> <!-- index into effect chain, amp default -->
    </subjects>

</globals>
